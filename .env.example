# Copy this file to .env and fill in your values. .env is git-ignored - never commit it.

# --- Ollama cloud ---
OLLAMA_API_KEY=paste_your_new_key_here
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b

# --- OR local Ollama (no key needed) ---
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# --- Optional tuning ---
# OLLAMA_TIMEOUT=120
# ALERT_THRESHOLD=0.70
# CRITICAL_ASSETS=10.0.0.5,10.0.0.10,dc01,db-prod-01
